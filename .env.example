# Copy this file to .env.local and fill in the values from Supabase:
# Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Speech to text (OpenAI). Create a key at platform.openai.com, API keys.
# Keep this one SECRET: only ever put it in .env.local and Netlify's environment variables.
OPENAI_API_KEY=
# Optional: OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Google Calendar (Google Cloud Console > APIs & Services > Credentials > OAuth client).
# Keep ALL THREE secret: only ever in .env.local and Netlify's environment variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random text (40+ characters) from your password manager. It scrambles the saved Google key.
GOOGLE_TOKEN_KEY=

# Email (resend.com > API Keys). Keep SECRET: only in .env.local and Netlify's environment variables.
RESEND_API_KEY=
# Optional until you have your own domain: EMAIL_FROM="Yarn <hello@yourdomain.com.au>"

# The automatic 7am / 5pm emails. Keep BOTH secret: only in .env.local and Netlify's environment variables.
# Supabase > Project Settings > API Keys > "Secret key" (starts sb_secret_). Very powerful: never in the code.
SUPABASE_SECRET_KEY=
# Any long random text (30+ characters) from your password manager. Lets only Yarn's timer start a run.
CRON_SECRET=
# Optional: SITE_URL=https://yarnnatasha.netlify.app (used for the "Open Yarn" button)

# Push notifications. Make the pair once (see the steps Claude gave you) and keep the private one secret.
# The public key is not secret (phones are given it). SUBJECT is optional: mailto:you@yourdomain.com.au
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# Alerts. ALERT_EMAIL: where Yarn emails you if a briefing fails 3 times. HEALTH_TOKEN: any long random text (30+
# characters); a monitoring service uses it to check /api/health?key=... and tells you if the timer stops.
ALERT_EMAIL=
HEALTH_TOKEN=
