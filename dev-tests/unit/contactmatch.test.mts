import { matchContact } from "../.tmp/lib/contact-match.ts";
import assert from "node:assert/strict";
let n = 0; const ok = (name: string, f: () => void) => { f(); n++; console.log("ok -", name); };
const sam = { id: "sam", name: "Sam Lee", aliases: ["my accountant"], role: "Accountant" };
const kim = { id: "kim", name: "Kim Ortiz", aliases: ["Hafele rep"], role: "Sales rep" };
const bunnings = { id: "bun", name: "Bunnings Penrith", aliases: [], role: "Supplier" };
const all = [sam, kim, bunnings];
ok("the role is enough: 'Email the accountant about the BAS'", () => assert.equal(matchContact("Email the accountant about the BAS", all), "sam"));
ok("a role with no nickname set still matches", () => assert.equal(matchContact("Email accountant about BAS", [{ ...sam, aliases: [] }, kim]), "sam"));
ok("a first name matches", () => assert.equal(matchContact("Call Kim about hinges", all), "kim"));
ok("a nickname matches", () => assert.equal(matchContact("Meeting with the Hafele rep", all), "kim"));
ok("a full name matches", () => assert.equal(matchContact("Pay Bunnings Penrith account", all), "bun"));
ok("nobody named: no link", () => assert.equal(matchContact("Order soft-close hinges", all), null));
ok("two contacts named: no guess", () => assert.equal(matchContact("Ask Sam and Kim about the quote", all), null));
ok("two contacts share a role: no guess", () => assert.equal(matchContact("Call the accountant", [sam, { ...sam, id: "sam2", name: "Joe Bloggs", aliases: [] }]), null));
ok("whole words only ('same' is not 'Sam')", () => assert.equal(matchContact("Do the same again", all), null));
ok("case and punctuation do not matter", () => assert.equal(matchContact("EMAIL THE ACCOUNTANT, please!", all), "sam"));
ok("an empty title matches nothing", () => assert.equal(matchContact("  ", all), null));
console.log(`${n} passed`);
